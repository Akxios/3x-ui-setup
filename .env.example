# Минимальная конфигурация 3x-ui setup
#
# Перед запуском замените DOMAIN и LETSENCRYPT_EMAIL.
# Полный справочник переменных: docs/configuration.md

DOMAIN="example.com"
LETSENCRYPT_EMAIL="admin@example.com"

# Частые настройки
ENABLE_WWW="false"
INSTALL_3X_UI="true"
XRAY_TCP_PORTS="8443"

# Дополнительные порты, если кроме 3x-ui есть другие сервисы
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# Расширенные настройки не обязательны: скрипт подставляет дефолты.
# Примеры:
# ENABLE_FAIL2BAN="true"
# ENABLE_UFW="true"
# WEB_ROOT="/var/www/${DOMAIN}/html"
# CURRENT_SSH_PORTS=""
# XUI_PANEL_TCP_PORTS=""
# VERBOSE="false"
