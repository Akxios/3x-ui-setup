# Минимальная конфигурация VPS Bootstrap

DOMAIN="example.com"
LETSENCRYPT_EMAIL="admin@example.com"

# Частые настройки
ENABLE_WWW="false"
INSTALL_3X_UI="true"
XRAY_TCP_PORTS="8443"

# Дополнительные порты, если кроме 3x-ui есть другие сервисы
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# Расширенные настройки не обязательны: скрипт подставляет безопасные дефолты.
# Полный список полей: docs/configuration.md
# Примеры:
# ENABLE_FAIL2BAN="true"
# ENABLE_UFW="true"
# WEB_ROOT="/var/www/${DOMAIN}/html"
# CURRENT_SSH_PORTS=""
# XUI_PANEL_TCP_PORTS=""
# VERBOSE="false"
