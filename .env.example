# ==========================================
# VPS Bootstrap MVP config
# ==========================================

# Server identity
SERVER_NAME="test_server"
DOMAIN="example.com"
ENABLE_WWW="false"

# ==========================================
# Nginx
# ==========================================
ENABLE_NGINX="true"
WEB_ROOT="/var/www/${DOMAIN}/html"

# true  = issue Let's Encrypt cert automatically and enable HTTPS stub
# false = use NGINX_USE_HTTPS/manual cert config below
NGINX_AUTO_HTTPS="true"
LETSENCRYPT_EMAIL="admin@example.com"

# false = only HTTP stub
# true  = HTTPS config with existing Let's Encrypt cert paths
NGINX_USE_HTTPS="false"
NGINX_CERT_PATH="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
NGINX_CERT_KEY_PATH="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"

# ==========================================
# Firewall / UFW
# ==========================================
ENABLE_UFW="true"
UFW_DEFAULT_INCOMING="deny"
UFW_DEFAULT_OUTGOING="allow"

# The script does NOT change SSH settings.
# It only keeps current SSH ports open in UFW.
# Leave empty for auto-detection via `sshd -T`.
# Example:
# CURRENT_SSH_PORTS="22"
# CURRENT_SSH_PORTS="501"
CURRENT_SSH_PORTS=""
LIMIT_SSH_PORT="true"

# Base web ports
WEB_TCP_PORTS="80 443/tpc"
WEB_UDP_PORTS=""

# ==========================================
# 3x-ui / Xray ports
# ==========================================
ENABLE_3X_UI_PORTS="true"

# Edit according to your real Xray inbounds.
XRAY_TCP_PORTS="8443/tcp"
XRAY_UDP_PORTS=""

# 3x-ui panel ports are intentionally not opened by default.
# Open them manually if you expose panel to public network.
XUI_PANEL_TCP_PORTS=""

# Extra manually installed services.
# Example for AmneziaWG after installing it through the app:
# EXTRA_UDP_PORTS="38586"
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# ==========================================
# Fail2Ban
# ==========================================
ENABLE_FAIL2BAN="true"
FAIL2BAN_BANTIME="1h"
FAIL2BAN_FINDTIME="10m"
FAIL2BAN_MAXRETRY="3"
FAIL2BAN_BANACTION="ufw"
FAIL2BAN_IGNORE_IPS="127.0.0.1/8 ::1"
ENABLE_NGINX_BOTSEARCH="true"

# ==========================================
# 3x-ui installation
# ==========================================
# true = run official 3x-ui installer
# false = only open configured ports
INSTALL_3X_UI="true"
THREE_X_UI_INSTALL_URL="https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh"
