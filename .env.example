# Минимальная конфигурация 3x-ui setup
#
# Перед запуском замените DOMAIN и LETSENCRYPT_EMAIL.
# Полный справочник переменных: docs/configuration.md

DOMAIN="example.com"
LETSENCRYPT_EMAIL="admin@example.com"

# Частые настройки
ENABLE_WWW="false"
INSTALL_3X_UI="true"
XUI_AUTO_CONFIGURE="true"
XRAY_TCP_PORTS="8443"

# Панель и подписки доступны через HTTPS nginx (443/tcp).
# Внутренние порты по умолчанию 2053 и 2096; наружу не открываются.
# XUI_PANEL_PORT="2053"
# XUI_SUB_PORT="2096"
# Для существующей панели укажите ТЕКУЩИЕ реквизиты, если они не сохранены.
# XUI_USERNAME=""
# XUI_PASSWORD=""

# Дополнительные порты, если кроме 3x-ui есть другие сервисы
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# Расширенные настройки не обязательны: скрипт подставляет дефолты.
# Примеры:
# ENABLE_FAIL2BAN="true"
# ENABLE_UFW="true"
# WEB_ROOT="/var/www/${DOMAIN}/html"
# CURRENT_SSH_PORTS=""
# XUI_PANEL_TCP_PORTS=""
# VERBOSE="false"
# REMOVE_UFW_DISABLE="false"  # Даже remove all сохраняет включённый firewall.
# LOG_DIR="/var/log/vps-bootstrap"  # Допустим только этот каталог и его подкаталоги.
