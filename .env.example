# ==========================================
# Конфигурация VPS Bootstrap
# ==========================================

# Идентификация сервера
SERVER_NAME="test_server"
DOMAIN="example.com"
ENABLE_WWW="false"

# ==========================================
# Nginx
# ==========================================
ENABLE_NGINX="true"
WEB_ROOT="/var/www/${DOMAIN}/html"

# true  = автоматически выпустить сертификат Let's Encrypt и включить HTTPS
# false = использовать ручную конфигурацию HTTPS ниже
NGINX_AUTO_HTTPS="true"
LETSENCRYPT_EMAIL="admin@example.com"

# false = только HTTP заглушка
# true  = HTTPS с уже существующими сертификатами
NGINX_USE_HTTPS="false"
NGINX_CERT_PATH="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
NGINX_CERT_KEY_PATH="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"

# ==========================================
# Firewall / UFW
# ==========================================
ENABLE_UFW="true"
UFW_DEFAULT_INCOMING="deny"
UFW_DEFAULT_OUTGOING="allow"
UFW_RESET_RULES="false"

# Скрипт НЕ изменяет настройки SSH.
# Он только оставляет текущие SSH-порты открытыми в UFW.
# Оставьте пустым для автоопределения через `sshd -T`.
# Примеры:
# CURRENT_SSH_PORTS="22"
# CURRENT_SSH_PORTS="501"
CURRENT_SSH_PORTS=""
LIMIT_SSH_PORT="true"

# Базовые web-порты
WEB_TCP_PORTS="80 443"
WEB_UDP_PORTS=""

# ==========================================
# 3x-ui / Xray порты
# ==========================================
ENABLE_3X_UI_PORTS="true"

# Укажите реальные inbound-порты Xray
XRAY_TCP_PORTS="8443"
XRAY_UDP_PORTS=""

# Порты панели 3x-ui по умолчанию НЕ открываются
# Открывайте вручную, если панель доступна из интернета
XUI_PANEL_TCP_PORTS=""

# Дополнительные вручную установленные сервисы
# Пример для AmneziaWG:
# EXTRA_UDP_PORTS="38586"
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# ==========================================
# Fail2Ban
# ==========================================
ENABLE_FAIL2BAN="true"
FAIL2BAN_BANTIME="1h"
FAIL2BAN_FINDTIME="10m"
FAIL2BAN_MAXRETRY="3"
FAIL2BAN_BANACTION="ufw"
FAIL2BAN_IGNORE_IPS="127.0.0.1/8 ::1"
ENABLE_NGINX_BOTSEARCH="true"

# ==========================================
# Установка 3x-ui
# ==========================================
# true  = запустить официальный installer 3x-ui
# false = только открыть настроенные порты
INSTALL_3X_UI="true"
THREE_X_UI_INSTALL_URL="https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh"
